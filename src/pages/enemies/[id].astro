---
import WikiLayout from '../../layouts/WikiLayout.astro';
import UnitDetail from '../../components/UnitDetail.vue';
import { getAllEnemies, getAllItems } from '../../lib/data';
import { base } from '../../lib/base';

export function getStaticPaths() {
  const enemiesData = getAllEnemies();
  return enemiesData.map((e) => ({ params: { id: e.id }, props: { unit: e } }));
}

const { unit } = Astro.props as { unit: any };
const s = unit.stats ?? {};

const stats = [
  { label: 'HP', value: s.hp ?? '—' },
  { label: 'CON', value: s.constitution ?? '—' },
  { label: 'INT', value: s.intelligence ?? '—' },
  { label: 'DEX', value: s.dexterity ?? '—' },
  { label: 'DEF', value: s.defense ?? '—' },
  { label: 'MDEF', value: s.magicDefense ?? '—' },
  { label: 'DMG', value: `${unit.damage?.min ?? '?'} – ${unit.damage?.max ?? '?'}` },
];
const tags = [unit.type, unit.isBoss ? 'Boss' : '', unit.expGiven ? `EXP ${unit.expGiven}` : ''].filter(Boolean);
const itemIds = new Set(getAllItems().map((i: any) => i.id));
const drops = (unit.drops ?? []).map((d: any) => ({
  name: d.name || d.item,
  href: itemIds.has(d.item) ? `${base}/items/${d.item}` : undefined,
  qty: d.qty,
  chance: d.chance,
  sprite: d.sprite,
}));
---

<WikiLayout title={unit.name} description={`${unit.name} enemy stats and drops`}>
  <UnitDetail
    client:load
    name={unit.name}
    sprite={unit.sprite}
    tags={tags}
    stats={stats}
    drops={drops}
    backHref={`${base}/enemies`}
    backLabel="Back to Bestiary"
    basePath={base}
  />
</WikiLayout>
