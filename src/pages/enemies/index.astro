---
import WikiLayout from '../../layouts/WikiLayout.astro';
import EnemyBrowser from '../../components/EnemyBrowser.vue';
import { getAllEnemies } from '../../lib/data';
import { base } from '../../lib/base';

const enemiesData = getAllEnemies();
---

<WikiLayout title="Bestiary" description="Complete enemy drops and encounter locations in Idle Guild Master Modded.">
  <div class="pageHeader">
    <h1>Bestiary</h1>
    <p>
      Comprehensive bestiary of wild beasts, dungeon monsters, corrupted horrors, and raid bosses.
      Filter by name, item drops, or encounter locations.
    </p>
  </div>

  <EnemyBrowser client:load enemies={enemiesData as any} basePath={base} />
</WikiLayout>

<style>
.pageHeader {
  margin-bottom: 1.5rem;
}
.pageHeader p {
  max-width: 800px;
}
</style>
