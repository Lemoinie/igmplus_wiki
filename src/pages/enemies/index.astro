---
import WikiLayout from '../../layouts/WikiLayout.astro';
import EnemyCard from '../../components/EnemyCard.vue';
import enemiesData from '../../data/enemies.json';
---

<WikiLayout title="Enemies & Bestiary" description="Complete enemy stats, damages, and item drops in Idle Guild Master Modded.">
  <div class="pageHeader">
    <h1>Enemies & Bestiary</h1>
    <p>
      Comprehensive bestiary of wild beasts, dungeon monsters, corrupted horrors, and raid bosses.
    </p>
  </div>

  <div class="enemiesGrid">
    {enemiesData.map((e) => (
      <a href={`/igmplus_wiki/enemies/${e.id}`} class="enemyLink">
        <EnemyCard client:load enemy={e as any} basePath="/igmplus_wiki" />
      </a>
    ))}
  </div>
</WikiLayout>

<style>
.pageHeader {
  margin-bottom: 1.5rem;
}
.enemiesGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.25rem;
}
.enemyLink {
  display: block;
  color: inherit;
  text-decoration: none;
}
.enemyLink:hover :global(.enemyCard) {
  border-color: var(--brand-primary);
}
</style>
