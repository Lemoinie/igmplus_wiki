---
import WikiLayout from '../layouts/WikiLayout.astro';
import classes from '../data/classes.json';
import equipment from '../data/equipment.json';
import pets from '../data/pets.json';
import enemies from '../data/enemies.json';
import dungeons from '../data/dungeons.json';
import { base } from '../lib/base';

const stats = [
  { label: 'Classes', count: classes.length, icon: '⚔️', href: `${base}/classes` },
  { label: 'Items', count: equipment.length, icon: '🛡️', href: `${base}/equipment` },
  { label: 'Pets', count: pets.length, icon: '🐾', href: `${base}/pets` },
  { label: 'Bestiary', count: enemies.length, icon: '👾', href: `${base}/enemies` },
  { label: 'Places', count: dungeons.length, icon: '🗺️', href: `${base}/dungeons` },
];
---

<WikiLayout title="Home" description="Idle Guild Master Modded Community Wiki">
  <div class="hero">
    <h1 class="heroTitle">Idle Guild Master Modded Wiki</h1>
    <p class="heroSubtitle">
      Comprehensive, data-driven database for classes, items, builds, pets, dungeons, and combat mechanics.
    </p>

    <!-- Stat Badges -->
    <div class="statsRow">
      {stats.map((s) => (
        <a href={s.href} class="statCard">
          <span class="statIcon">{s.icon}</span>
          <div class="statInfo">
            <span class="statCount">{s.count}</span>
            <span class="statLabel">{s.label}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <section class="section">
    <h2>Explore the Wiki</h2>
    <div class="featureGrid">
      <a href={`${base}/classes`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/unit_singularity_magus.png`} alt="Classes" class="cardArt spriteArt" />
        </div>
        <h3>Classes</h3>
      </a>

      <a href={`${base}/equipment`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/colossal_sword_of_scarlet_king.png`} alt="Items" class="cardArt spriteArt" />
        </div>
        <h3>Items</h3>
      </a>

      <a href={`${base}/pets`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/pet_phoenix.png`} alt="Pets" class="cardArt spriteArt" />
        </div>
        <h3>Pets</h3>
      </a>

      <a href={`${base}/enemies`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/scarlet_grand_mage.png`} alt="Bestiary" class="cardArt spriteArt" />
        </div>
        <h3>Bestiary</h3>
      </a>

      <a href={`${base}/dungeons`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/area_scarlet.png`} alt="Places" class="cardArt bannerArt" />
        </div>
        <h3>Places</h3>
      </a>
    </div>
  </section>
</WikiLayout>

<style>
.hero {
  text-align: center;
  padding: 2.5rem 1rem 3rem 1rem;
  background: radial-gradient(circle at 50% 0%, rgba(110, 168, 254, 0.12), transparent 70%);
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  margin-bottom: 2.5rem;
}

.heroTitle {
  font-size: 2.5rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.02em;
  margin-bottom: 0.75rem;
}

.heroSubtitle {
  font-size: 1.1rem;
  color: var(--text-secondary);
  max-width: 650px;
  margin: 0 auto 2rem auto;
}

.statsRow {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

.statCard {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.75rem 1.25rem;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: 8px;
  text-decoration: none;
  transition: all 0.15s ease;
}

.statCard:hover {
  transform: translateY(-2px);
  border-color: var(--brand-primary);
  text-decoration: none;
}

.statIcon {
  font-size: 1.6rem;
}

.statInfo {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.statCount {
  font-size: 1.3rem;
  font-weight: 800;
  color: #fff;
  line-height: 1.1;
}

.statLabel {
  font-size: 0.78rem;
  color: var(--text-muted);
}

.section {
  margin-bottom: 3rem;
}

.section h2 {
  font-size: 1.5rem;
  margin-bottom: 1.5rem;
  text-align: center;
}

.featureGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.25rem;
}

.featureCard {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: 12px;
  padding: 1.75rem 1rem 1.5rem 1rem;
  text-decoration: none;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 0.85rem;
}

.featureCard:hover {
  transform: translateY(-4px);
  border-color: var(--brand-primary);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  text-decoration: none;
}

.cardArtBox {
  height: 96px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  box-shadow: none;
}

.cardArt {
  image-rendering: pixelated;
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.55));
  transition: transform 0.2s ease;
}

.featureCard:hover .cardArt {
  transform: scale(1.1);
}

.spriteArt {
  width: 88px;
  height: 88px;
  object-fit: contain;
}

.bannerArt {
  width: 120px;
  height: 68px;
  object-fit: cover;
  border-radius: 8px;
  border: none;
}

.featureCard h3 {
  font-size: 1.1rem;
  color: var(--text-primary);
  margin: 0;
  text-align: center;
  line-height: 1.3;
}

@media (max-width: 640px) {
  .hero {
    padding: 1.75rem 1rem 2rem 1rem;
    margin-bottom: 1.75rem;
  }
  .heroTitle {
    font-size: 1.75rem;
  }
  .heroSubtitle {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .statCard {
    padding: 0.6rem 0.9rem;
  }
  .statIcon {
    font-size: 1.3rem;
  }
  .statCount {
    font-size: 1.1rem;
  }
  .featureGrid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .featureCard {
    padding: 1.25rem 0.5rem;
  }
  .cardArtBox {
    height: 76px;
  }
  .spriteArt {
    width: 68px;
    height: 68px;
  }
  .bannerArt {
    width: 96px;
    height: 54px;
  }
  .featureCard h3 {
    font-size: 0.95rem;
  }
}
</style>
