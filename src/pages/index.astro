---
import WikiLayout from '../layouts/WikiLayout.astro';
import { base } from '../lib/base';
---

<WikiLayout title="Home" description="Idle Guild Master Modded Community Wiki">
  <div class="hero">
    <h1 class="heroTitle">Idle Guild Master Modded Wiki</h1>
    <p class="heroSubtitle">
      Comprehensive database for classes, items, builds, pets, dungeons, and combat mechanics.
    </p>

    <!-- Notices -->
    <div class="noticeContainer">
      <div class="noticeCard">
        <div class="noticeIcon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
        </div>
        <div class="noticeBody">
          <div class="noticeTag">Notice</div>
          <p class="noticeText">
            Join the <a href="https://discord.com/invite/rFRg7bB4Y2" target="_blank" rel="noopener noreferrer" class="discordLink">Idle Guild Master Plus</a> Discord server for suggestions, new updates, and bug reports!
          </p>
        </div>
        <a href="https://discord.com/invite/rFRg7bB4Y2" target="_blank" rel="noopener noreferrer" class="discordBtn">
          Join Discord
        </a>
      </div>
    </div>
  </div>

  <section class="section">
    <h2>Explore the Wiki</h2>
    <div class="featureGrid">
      <a href={`${base}/classes`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/unit_singularity_magus.png`} alt="Classes" class="cardArt spriteArt" />
        </div>
        <h3>Classes</h3>
      </a>

      <a href={`${base}/equipment`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/colossal_sword_of_scarlet_king.png`} alt="Items" class="cardArt spriteArt" />
        </div>
        <h3>Items</h3>
      </a>

      <a href={`${base}/pets`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/pet_phoenix.png`} alt="Pets" class="cardArt spriteArt" />
        </div>
        <h3>Pets</h3>
      </a>

      <a href={`${base}/enemies`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/scarlet_grand_mage.png`} alt="Bestiary" class="cardArt spriteArt" />
        </div>
        <h3>Bestiary</h3>
      </a>

      <a href={`${base}/dungeons`} class="featureCard">
        <div class="cardArtBox">
          <img src={`${base}/images/area_scarlet.png`} alt="Places" class="cardArt bannerArt" />
        </div>
        <h3>Places</h3>
      </a>
    </div>
  </section>

  <section class="section">
    <h2>Note</h2>
    <div class="noteGrid">
      <div class="infoCard">
        <div class="infoCardHeader">
          <span class="infoCardIcon">ℹ️</span>
          <h3>Info</h3>
        </div>
        <div class="infoCardContent">
          <div class="infoRow">
            <span class="infoLabel">Authors:</span>
            <span class="infoValue">lemoinie and angyy</span>
          </div>
          <div class="infoRow">
            <span class="infoLabel">Sponsor:</span>
            <span class="infoValue">zhauz_</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</WikiLayout>

<style>
.hero {
  text-align: center;
  padding: 2.5rem 1rem 3rem 1rem;
  background: radial-gradient(circle at 50% 0%, rgba(110, 168, 254, 0.12), transparent 70%);
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  margin-bottom: 2.5rem;
}

.heroTitle {
  font-size: 2.5rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.02em;
  margin-bottom: 0.75rem;
}

.heroSubtitle {
  font-size: 1.1rem;
  color: var(--text-secondary);
  max-width: 650px;
  margin: 0 auto 2rem auto;
}

.noticeContainer {
  display: flex;
  justify-content: center;
  width: 100%;
}

.noticeCard {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1rem 1.5rem;
  background: linear-gradient(135deg, rgba(88, 101, 242, 0.18), rgba(15, 23, 42, 0.7));
  border: 1px solid rgba(88, 101, 242, 0.35);
  border-radius: 12px;
  max-width: 760px;
  width: 100%;
  text-align: left;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
}

.noticeCard:hover {
  border-color: rgba(88, 101, 242, 0.6);
  box-shadow: 0 6px 24px rgba(88, 101, 242, 0.2);
}

.noticeIcon {
  color: #5865F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  background: rgba(88, 101, 242, 0.15);
  border-radius: 10px;
}

.noticeBody {
  flex: 1;
}

.noticeTag {
  font-size: 0.75rem;
  font-weight: 700;
  color: #7289da;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.25rem;
}

.noticeText {
  margin: 0;
  font-size: 0.95rem;
  color: var(--text-primary);
  line-height: 1.45;
}

.discordLink {
  color: #6ea8fe;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.discordLink:hover {
  color: #9ec5fe;
}

.discordBtn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.2rem;
  background: #5865F2;
  color: #fff;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.15s ease;
  box-shadow: 0 2px 8px rgba(88, 101, 242, 0.4);
}

.discordBtn:hover {
  background: #4752c4;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(88, 101, 242, 0.5);
  text-decoration: none;
}

.section {
  margin-bottom: 3rem;
}

.section h2 {
  font-size: 1.5rem;
  margin-bottom: 1.5rem;
  text-align: center;
}

.featureGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.25rem;
}

.featureCard {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: 12px;
  padding: 1.75rem 1rem 1.5rem 1rem;
  text-decoration: none;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 0.85rem;
}

.featureCard:hover {
  transform: translateY(-4px);
  border-color: var(--brand-primary);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  text-decoration: none;
}

.cardArtBox {
  height: 96px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  box-shadow: none;
}

.cardArt {
  image-rendering: pixelated;
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.55));
  transition: transform 0.2s ease;
}

.featureCard:hover .cardArt {
  transform: scale(1.1);
}

.spriteArt {
  width: 88px;
  height: 88px;
  object-fit: contain;
}

.bannerArt {
  width: 120px;
  height: 68px;
  object-fit: cover;
  border-radius: 8px;
  border: none;
}

.featureCard h3 {
  font-size: 1.1rem;
  color: var(--text-primary);
  margin: 0;
  text-align: center;
  line-height: 1.3;
}

.noteGrid {
  display: flex;
  justify-content: center;
  width: 100%;
}

.infoCard {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: 12px;
  padding: 1.5rem 1.75rem;
  max-width: 440px;
  width: 100%;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  transition: all 0.2s ease;
}

.infoCard:hover {
  border-color: var(--brand-primary);
  transform: translateY(-2px);
}

.infoCardHeader {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 1.1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-subtle);
}

.infoCardIcon {
  font-size: 1.25rem;
}

.infoCardHeader h3 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
  color: #fff;
}

.infoCardContent {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.infoRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.95rem;
}

.infoLabel {
  color: var(--text-muted);
  font-weight: 500;
}

.infoValue {
  color: var(--text-primary);
  font-weight: 600;
}

@media (max-width: 640px) {
  .hero {
    padding: 1.75rem 1rem 2rem 1rem;
    margin-bottom: 1.75rem;
  }
  .heroTitle {
    font-size: 1.75rem;
  }
  .heroSubtitle {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .noticeCard {
    flex-direction: column;
    text-align: center;
    padding: 1.25rem 1rem;
    gap: 1rem;
  }
  .noticeIcon {
    width: 40px;
    height: 40px;
  }
  .noticeText {
    font-size: 0.9rem;
  }
  .discordBtn {
    width: 100%;
    justify-content: center;
  }
  .featureGrid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .featureCard {
    padding: 1.25rem 0.5rem;
  }
  .cardArtBox {
    height: 76px;
  }
  .spriteArt {
    width: 68px;
    height: 68px;
  }
  .bannerArt {
    width: 96px;
    height: 54px;
  }
  .featureCard h3 {
    font-size: 0.95rem;
  }
  .infoCard {
    padding: 1.25rem 1rem;
  }
}
</style>
