---
import WikiLayout from '../../layouts/WikiLayout.astro';
import EquipmentBrowser from '../../components/EquipmentBrowser.vue';
import equipmentData from '../../data/equipment.json';
import { base } from '../../lib/base';

// Automatically merge any standalone item files from src/data/items/**/*.json or src/data/equipment/**/*.json
const itemModules = import.meta.glob(['../../data/items/**/*.json', '../../data/equipment/**/*.json'], { eager: true });
const itemMap = new Map();
equipmentData.forEach((e: any) => itemMap.set(e.id, e));
Object.values(itemModules).forEach((mod: any) => {
  const it = mod.default || mod;
  if (it && it.id) {
    itemMap.set(it.id, { ...(itemMap.get(it.id) || {}), ...it });
  }
});
const combinedEquipment = Array.from(itemMap.values());
---

<WikiLayout title="Equipment & Items" description="Browse all weapons, armors, and accessories in Idle Guild Master Modded.">
  <div class="pageHeader">
    <h1>Equipment & Items</h1>
    <p>
      Complete catalog of craftable and dropped swords, axes, bows, staves, daggers, robes, heavy armors, and accessories.
      Filter by item type, rarity tier, or search specific bonuses.
    </p>
  </div>

  <EquipmentBrowser client:load items={combinedEquipment as any} basePath={base} />
</WikiLayout>

<style>
.pageHeader {
  margin-bottom: 1.5rem;
}
.pageHeader p {
  max-width: 800px;
}
</style>
