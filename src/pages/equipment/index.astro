---
import { base } from '../../lib/base';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${base}/items`} />
    <link rel="canonical" href={`${base}/items`} />
    <title>Redirecting to Items | IGM+ Wiki</title>
  </head>
  <body>
    <p>Redirecting to <a href={`${base}/items`}>Items</a>...</p>
    <script define:vars={{ dest: `${base}/items` }}>
      window.location.replace(dest);
    </script>
  </body>
</html>
