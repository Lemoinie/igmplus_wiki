---
import WikiLayout from '../../layouts/WikiLayout.astro';
import TraitBrowser from '../../components/TraitBrowser.vue';
import { getAllTraits } from '../../lib/data';
import { base } from '../../lib/base';

const traitsData = getAllTraits();
---

<WikiLayout title="Adventurer Traits & Upgrades" description="Catalog of basic traits, rare traits, and their upgraded Plus (+) variants in Idle Guild Master Plus.">
  <TraitBrowser client:load traits={traitsData as any} basePath={base} />
</WikiLayout>
