---
import WikiLayout from '../../layouts/WikiLayout.astro';
import PetBrowser from '../../components/PetBrowser.vue';
import petsData from '../../data/pets.json';
import { base } from '../../lib/base';
---

<WikiLayout
  title="Guild Pets"
  description="All 23 guild pets in Idle Guild Master Modded. Check trait slot capacities, guaranteed ability pools, and unique passive effects."
>
  <div class="pageHeader">
    <div class="headerTop">
      <h1>Guild Pets</h1>
      <span class="petCountBadge">{petsData.length} Pets</span>
    </div>
    <p>
      Companions hatched and nurtured by your guild. Pets provide powerful passive buffs, healing, barriers,
      and combat effects. Filter by family below or search for specific guaranteed trait pools and unique traits.
    </p>
  </div>

  <PetBrowser client:load pets={petsData as any} basePath={base} />
</WikiLayout>

<style>
.pageHeader {
  margin-bottom: 1.5rem;
}

.headerTop {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 0.5rem;
}

.headerTop h1 {
  margin: 0;
}

.petCountBadge {
  font-size: 0.82rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 12px;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  color: var(--text-gold);
}

.pageHeader p {
  color: var(--text-secondary);
  max-width: 850px;
  line-height: 1.55;
  margin: 0;
}
</style>
