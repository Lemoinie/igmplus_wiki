---
import WikiLayout from '../../layouts/WikiLayout.astro';
import PetTable from '../../components/PetTable.vue';
import { getAllPets } from '../../lib/data';
import { base } from '../../lib/base';

const petsData = getAllPets();
---

<WikiLayout
  title="Pets"
  description="All 23 guild pets in Idle Guild Master Plus. Check trait slot capacities, egg types, guaranteed first traits, and unique traits."
>
  <PetTable client:load pets={petsData as any} basePath={base} />
</WikiLayout>
