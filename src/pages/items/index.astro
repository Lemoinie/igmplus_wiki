---
import WikiLayout from '../../layouts/WikiLayout.astro';
import EquipmentBrowser from '../../components/EquipmentBrowser.vue';
import { getAllItems, getItemRecipeMaps } from '../../lib/data';
import { base } from '../../lib/base';

const { ownRecipeMap, usedInRecipesMap } = getItemRecipeMaps();
const combinedEquipment = getAllItems().map((item) => ({
  ...item,
  ownRecipe: ownRecipeMap.get(item.id) || [],
  usedInRecipes: usedInRecipesMap.get(item.id) || [],
}));
---

<WikiLayout title="Items" description="Browse all weapons, armors, accessories, and crafting items in Idle Guild Master Plus.">
  <EquipmentBrowser client:load items={combinedEquipment as any} basePath={base} />
</WikiLayout>
