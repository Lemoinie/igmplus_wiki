---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { base } from '../../lib/base';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/notices/*.md', { eager: true });
  const entries = Object.entries(posts).map(([filePath, post]: [string, any]) => {
    const slug = filePath.split('/').pop()?.replace('.md', '') || '';
    return {
      slug,
      post,
      frontmatter: post.frontmatter || {},
      date: post.frontmatter?.date || '2026-10-18',
    };
  });

  // Sort chronologically (oldest to newest for prev/next chaining)
  entries.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

  return entries.map((entry, index) => {
    const prevEntry = index > 0 ? entries[index - 1] : null;
    const nextEntry = index < entries.length - 1 ? entries[index + 1] : null;

    return {
      params: { slug: entry.slug },
      props: {
        post: entry.post,
        slug: entry.slug,
        prevNotice: prevEntry ? { slug: prevEntry.slug, title: prevEntry.frontmatter.title, category: prevEntry.frontmatter.category } : null,
        nextNotice: nextEntry ? { slug: nextEntry.slug, title: nextEntry.frontmatter.title, category: nextEntry.frontmatter.category } : null,
      },
    };
  });
}

const { post, slug, prevNotice, nextNotice } = Astro.props as {
  post: any;
  slug: string;
  prevNotice: { slug: string; title: string; category: string } | null;
  nextNotice: { slug: string; title: string; category: string } | null;
};

const { Content, frontmatter = {} } = post;
const title = frontmatter.title || 'Notice';
const description = frontmatter.description || '';
const category = frontmatter.category || 'Notice';
const version = frontmatter.version;
const date = frontmatter.date || '2026-10-18';
const author = frontmatter.author || 'IGM+ Team';
const coverImage = frontmatter.coverImage;
const tags: string[] = frontmatter.tags || [];

// Calculate rough reading time based on raw content
const words = (post.rawContent ? post.rawContent() : '').split(/\s+/).length || 500;
const readTime = Math.max(1, Math.ceil(words / 220));
---

<WikiLayout
  title={`${title} | Notices`}
  description={description}
  image={coverImage}
  type="article"
  publishDate={date}
>
  <div class="noticeDetailContainer">
    <!-- Top Navigation Bar -->
    <nav class="detailTopNav" aria-label="Notice breadcrumbs">
      <a href={`${base}/notices`} class="backBtn">
        <span class="backArrow">←</span>
        <span>Back to Notices</span>
      </a>

      <!-- Quick Actions: Copy Discord Link & Share -->
      <div class="shareActionGroup">
        <button
          type="button"
          id="copyDiscordLinkBtn"
          class="copyDiscordBtn"
          title="Copy formatted link to paste in Discord"
        >
          <svg class="shareIcon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
          </svg>
          <span class="btnText">Copy Discord Link</span>
        </button>

        <span id="copyToast" class="copyToast" role="status" aria-live="polite">
          ✓ Copied to clipboard!
        </span>
      </div>
    </nav>

    <!-- Main Notice Article -->
    <article class="noticeArticle">
      <!-- Article Header -->
      <header class="articleHeader">
        <div class="headerMetaRow">
          <span class:list={['categoryBadge', `badge-${category.toLowerCase().replace(/\s+/g, '-')}`]}>
            {category}
          </span>
          {version && (
            <span class="versionBadge">{version}</span>
          )}
          <time class="metaDate" datetime={date}>Published: {date.replace(/-/g, '/')}</time>
          <span class="readTimeBadge">{readTime} min read</span>
        </div>

        <h1 class="articleTitle">{title}</h1>

        {description && (
          <p class="articleExcerpt">{description}</p>
        )}

        <div class="authorRow">
          <span class="authorName">Author: <strong>{author}</strong></span>
          {tags.length > 0 && (
            <div class="headerTags">
              {tags.map((t) => (
                <span class="headerTag">#{t}</span>
              ))}
            </div>
          )}
        </div>

        {coverImage && (
          <div class="heroCover">
            <img
              src={`${base}${coverImage.startsWith('/') ? '' : '/'}${coverImage}`}
              alt={title}
              class="heroCoverImg"
            />
          </div>
        )}
      </header>

      <!-- Markdown Prose Content -->
      <div class="articleBody proseContent">
        <Content />
      </div>

      <!-- Article Footer -->
      <footer class="articleFooter">
        <div class="footerShareBox">
          <div class="footerShareLeft">
            <h4>Share this Announcement</h4>
            <p>Paste this link directly into Discord channels, guilds, or forums.</p>
          </div>
          <button type="button" class="footerCopyBtn" onclick="document.getElementById('copyDiscordLinkBtn')?.click()">
            Copy Notice URL
          </button>
        </div>

        <!-- Previous / Next Notice Navigation -->
        <div class="prevNextGrid">
          {prevNotice ? (
            <a href={`${base}/notices/${prevNotice.slug}`} class="prevNextCard prevCard">
              <span class="cardDirection">← Previous Notice</span>
              <span class="cardNoticeTitle">{prevNotice.title}</span>
            </a>
          ) : (
            <div class="prevNextCard emptyCard">
              <span class="cardDirection">Beginning of updates</span>
            </div>
          )}

          {nextNotice ? (
            <a href={`${base}/notices/${nextNotice.slug}`} class="prevNextCard nextCard">
              <span class="cardDirection">Next Notice →</span>
              <span class="cardNoticeTitle">{nextNotice.title}</span>
            </a>
          ) : (
            <div class="prevNextCard emptyCard">
              <span class="cardDirection">Latest Announcement</span>
            </div>
          )}
        </div>
      </footer>
    </article>
  </div>
</WikiLayout>

<script>
  function setupCopyLink() {
    const copyBtn = document.getElementById('copyDiscordLinkBtn');
    const toast = document.getElementById('copyToast');

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', async () => {
        try {
          const currentUrl = window.location.href;
          await navigator.clipboard.writeText(currentUrl);
          
          toast.classList.add('visible');
          setTimeout(() => {
            toast.classList.remove('visible');
          }, 2400);
        } catch (err) {
          // Fallback if clipboard API is restricted
          prompt('Copy this notice link for Discord:', window.location.href);
        }
      });
    }
  }

  if (typeof document !== 'undefined') {
    setupCopyLink();
    document.addEventListener('astro:page-load', setupCopyLink);
  }
</script>

<style>
.noticeDetailContainer {
  max-width: 880px;
  margin: 0 auto;
  padding: 0.5rem 0 3.5rem 0;
}

/* ================= Top Nav Bar ================= */
.detailTopNav {
