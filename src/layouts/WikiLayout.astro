---
import Analytics from '@vercel/analytics/astro';
import Sidebar from '../components/Sidebar.vue';
import SidebarToggle from '../components/SidebarToggle.vue';
import SearchBar from '../components/SearchBar.vue';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  publishDate?: string;
}

const {
  title = 'IGM+ Wiki',
  description = 'Idle Guild Master Mod Community Wiki',
  image,
  type = 'website',
  publishDate,
} = Astro.props;

// Global search index built statically from modular JSON data
import {
  getAllClasses,
  getAllItems,
  getAllTraits,
  getAllPets,
  getAllEnemies,
  getAllPlaces,
  getAllStatusEffects,
} from '../lib/data';

import { base } from '../lib/base';
import { getMaintenanceConfig } from '../lib/maintenance';

const maintenance = getMaintenanceConfig();
const isFull = maintenance.mode === 'full';
const isSoft = maintenance.mode === 'soft';

const classesList = getAllClasses();
const equipmentList = getAllItems();
const traitsList = getAllTraits();
const petsList = getAllPets();
const enemiesList = getAllEnemies();
const dungeonsList = getAllPlaces();
const effectsList = getAllStatusEffects();

const searchEntries = [
  ...classesList.map((c: any) => ({
    id: `class-${c.id}`,
    title: c.name,
    category: 'Class' as const,
    url: `${base}/classes/${c.id}`,
    description: `Tier ${c.tier} ${c.category} · ${c.weaponType} / ${c.armorType}`
  })),
  ...equipmentList.map((e: any) => ({
    id: `equip-${e.id}`,
    title: e.name,
    category: 'Item' as const,
    url: `${base}/items#${e.id}`,
    description: `★${e.rarity} ${e.category} · Price: ${e.price}`
  })),
  ...petsList.map((p: any) => ({
    id: `pet-${p.id}`,
    title: p.name,
    category: 'Pet' as const,
    url: `${base}/pets#pet-${p.id}`,
    description: `${p.family} pet · ${p.abilitySlots} trait slots · ${(p.guaranteedAbilities || []).join(', ')}`
  })),
  ...traitsList.map((t: any) => ({
    id: `trait-${t.id}`,
    title: t.name,
    category: 'Trait' as const,
    url: `${base}/traits#${t.id}`,
    description: t.description
  })),
  ...enemiesList.map((en: any) => ({
    id: `enemy-${en.id}`,
    title: en.name,
    category: 'Bestiary' as const,
    url: `${base}/enemies/${en.id}`,
    description: `${en.isBoss ? 'Boss' : 'Enemy'} · HP: ${en.stats?.hp} · DMG: ${en.damage?.min}-${en.damage?.max}`
  })),
  ...dungeonsList.map((d: any) => ({
    id: `dungeon-${d.id}`,
    title: d.name,
    category: 'Locations' as const,
    url: `${base}/dungeons#${d.id}`,
    description: `${d.type.toUpperCase()} · ${d.encounterChance}% encounter rate`
  })),
  ...effectsList.map((ef: any) => ({
    id: `effect-${ef.id}`,
    title: ef.name,
    category: 'Mechanics' as const,
    url: `${base}/effects#${ef.id}`,
    description: `${ef.category.toUpperCase()} · ${ef.description.slice(0, 60)}...`
  })),
  {
    id: 'mech-defense',
    title: 'Defense Mechanic',
    category: 'Mechanics' as const,
    url: `${base}/mechanics/defense-and-armor`,
    description: 'Damage mitigation formula, effective DEF, and interactive calculator'
  },
  {
    id: 'mech-attack-speed',
    title: 'Attack Speed',
    category: 'Mechanics' as const,
    url: `${base}/mechanics/attack-speed`,
    description: 'Multi-strike scaling, strike chance, and action frequency'
  },
  {
    id: 'mech-damage-dealt',
    title: 'Damage Dealt',
    category: 'Mechanics' as const,
    url: `${base}/mechanics/damage-dealt`,
    description: 'Universal outgoing damage scaling, combat buffs, and debuffs'
  },
  {
    id: 'mech-damage-taken',
    title: 'Damage Taken',
    category: 'Mechanics' as const,
    url: `${base}/mechanics/damage-taken`,
    description: 'Universal incoming damage modifier, curses, and mitigation flow'
  },
  {
    id: 'mech-basic-atk-amp',
    title: 'Basic Atk Amp',
    category: 'Mechanics' as const,
    url: `${base}/mechanics/basic-atk-amp`,
    description: 'Standard weapon strike scaling, Alert+, and Deadly Finesse trade-offs'
  },
  {
    id: 'mech-skill-amp',
    title: 'Skill Amp',
    category: 'Mechanics' as const,
    url: `${base}/mechanics/skill-amp`,
    description: 'Active skill and spell scaling, Aether Resonance, and Scarlet Sigil'
  },
  /*
  {
    id: 'nav-notices',
    title: 'Notices & Patch Notes',
    category: 'Notice' as const,
    url: `${base}/notices`,
    description: 'Official patch notes, developer notes, and community updates'
  }
  */
];

const siteTitle = isFull ? `${maintenance.fullTitle} | IGM+ Wiki` : `${title} | IGM+ Wiki`;
const metaDesc = isFull ? maintenance.fullMessage : description;
const defaultImage = `${base}/images/sha.png`;
const ogImage = image
  ? (image.startsWith('http') ? image : `${base}${image.startsWith('/') ? '' : '/'}${image}`)
  : defaultImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="shortcut icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/favicon.png`} />
    <title>{siteTitle}</title>
    <meta name="description" content={metaDesc} />
    {isFull && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Discord Link Previews -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="IGM+ Wiki" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    {isFull ? (
      <div class="fullMaintenanceRoot">
        <div class="maintenanceCard">
          <div class="cardHeader">
            <img
              src={`${base}/images/sha.png`}
              alt="Sha"
              class="shaLogo sprite"
              width="56"
              height="56"
            />
            <div class="statusBadge">
              <span class="pulsingDot" />
              <span>Maintenance in Progress</span>
            </div>
          </div>

          <h1 class="maintenanceTitle">{maintenance.fullTitle}</h1>
          <p class="maintenanceDesc">{maintenance.fullMessage}</p>

          {maintenance.fullSubtext && (
            <p class="maintenanceSubtext">{maintenance.fullSubtext}</p>
          )}

          {maintenance.estimatedTime && (
            <div class="etaBox">
              <span class="etaLabel">Estimated Duration:</span>
              <span class="etaValue">{maintenance.estimatedTime}</span>
            </div>
          )}

          <div class="cardActions">
            {maintenance.discordUrl && (
              <a
                href={maintenance.discordUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="actionBtn discordBtn"
              >
                Discord Community
              </a>
            )}
            {maintenance.githubUrl && (
              <a
                href={maintenance.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="actionBtn githubBtn"
              >
                GitHub Mod
              </a>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="layoutRoot">
        <!-- Sidebar Navigation -->
        <Sidebar client:load currentPath={Astro.url.pathname} />

        <!-- Main Layout Body -->
        <div class="mainWrapper">
          <!-- Sticky Top Group: Maintenance Notice & Header -->
          <div class="stickyTopGroup">
            {isSoft && (
              <div id="maintenanceBanner" class="maintenanceBanner">
                <div class="bannerContent">
                  <span class="bannerIcon">⚠️</span>
                  <span class="bannerText">
                    <strong>Maintenance Notice:</strong> {maintenance.softMessage}
                  </span>
                </div>
                <button
                  type="button"
                  id="dismissBannerBtn"
                  class="dismissBtn"
                  aria-label="Dismiss banner"
                >
                  ✕
                </button>
              </div>
            )}

            <!-- Top Header with Global Search and Sidebar Hamburger Toggle -->
            <header class="topHeader">
              <div class="headerLeft">
                <SidebarToggle client:load />

                <!-- Brand Logo & Name -->
                <a href={`${base}/`} class="navBrand" title="IGM+ Wiki Home">
                  <img
                    src={`${base}/images/sha.png`}
                    alt="Sha"
                    class="navShaLogo sprite"
                    width="28"
                    height="28"
                  />
                  <span class="navBrandName">IGM+ Wiki</span>
                </a>
              </div>

              <div class="headerCenter">
                <SearchBar client:load entries={searchEntries} />
              </div>

              <div class="headerRight">
                <span class="modBadge">v1.3.20.10</span>
              </div>
            </header>
          </div>

          <!-- Page Content -->
          <main class="pageContent">
            <slot />
          </main>

          <footer class="siteFooter">
            <p>Idle Guild Master Plus Community Wiki</p>
          </footer>
        </div>
      </div>
    )}

    {isSoft && (
      <script>
        const banner = document.getElementById('maintenanceBanner');
        const dismissBtn = document.getElementById('dismissBannerBtn');
        if (banner && dismissBtn) {
          if (sessionStorage.getItem('igm_dismiss_maintenance') === 'true') {
            banner.style.display = 'none';
          }
          dismissBtn.addEventListener('click', () => {
            banner.style.display = 'none';
            sessionStorage.setItem('igm_dismiss_maintenance', 'true');
          });
        }
      </script>
    )}

    <Analytics />
  </body>
</html>

<style>
.layoutRoot {
  display: flex;
  min-height: 100vh;
  width: 100%;
}

.mainWrapper {
  flex: 1;
  margin-left: 0;
  display: flex;
  flex-direction: column;
  min-width: 0;
  width: 100%;
}

.stickyTopGroup {
  position: sticky;
  top: 0;
  z-index: 120;
}

.topHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0.75rem 1.5rem;
  background: var(--bg-sidebar);
  border-bottom: 1px solid var(--border-subtle);
  position: relative;
  z-index: 120;
}

.headerLeft {
  display: flex;
  align-items: center;
  gap: 12px;
}

.navBrand {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
}

.navShaLogo {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  width: 28px;
  height: 28px;
  transition: transform 0.2s ease;
}

.navBrand:hover .navShaLogo {
  transform: scale(1.08);
}

.navBrandName {
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  white-space: nowrap;
}

.headerCenter {
  flex: 1;
  display: flex;
  justify-content: center;
  max-width: 600px;
  margin: 0 auto;
}

.headerRight {
  display: flex;
  align-items: center;
}

.modBadge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 4px;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  color: var(--text-gold);
  white-space: nowrap;
}

.pageContent {
  flex: 1;
  padding: 2rem 2.5rem;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
}

.siteFooter {
  padding: 1.5rem 2rem;
  border-top: 1px solid var(--border-subtle);
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-muted);
}

@media (max-width: 959px) {
  .topHeader {
    padding: 0.6rem 0.85rem;
    gap: 8px;
  }
  .maintenanceBanner {
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
  }
  .pageContent {
    padding: 1.25rem 0.85rem;
  }
}

@media (max-width: 768px) {
  .modBadge {
    display: none;
  }
}

@media (max-width: 480px) {
  .navBrandName {
    display: none;
  }
}

/* ================= Maintenance Styles ================= */
.maintenanceBanner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 0.75rem 1.5rem;
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.16) 0%, rgba(217, 119, 6, 0.08) 100%), var(--bg-sidebar);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(245, 158, 11, 0.35);
  color: #fef3c7;
  font-size: 0.9rem;
  position: relative;
  z-index: 36;
}

.bannerContent {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.bannerIcon {
  font-size: 1.2rem;
  line-height: 1;
  flex-shrink: 0;
}

.bannerText {
  line-height: 1.45;
  color: #fef3c7;
}

.bannerText strong {
  color: #fbbf24;
  margin-right: 4px;
}

.dismissBtn {
  background: transparent;
  border: 1px solid rgba(245, 158, 11, 0.25);
  color: rgba(254, 243, 199, 0.75);
  cursor: pointer;
  width: 26px;
  height: 26px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.dismissBtn:hover {
  background: rgba(245, 158, 11, 0.25);
  color: #ffffff;
  border-color: rgba(245, 158, 11, 0.6);
}

/* Full Maintenance Page Screen */
.fullMaintenanceRoot {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: radial-gradient(circle at 50% 30%, #161e2a 0%, var(--bg-main) 70%);
}

.maintenanceCard {
  background: var(--bg-card);
  border: 1px solid rgba(245, 158, 11, 0.3);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7), 0 0 30px rgba(245, 158, 11, 0.08);
  border-radius: 14px;
  padding: 2.75rem 2.25rem;
  max-width: 520px;
  width: 100%;
  text-align: center;
  animation: fadeIn 0.4s ease;
}

.cardHeader {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin-bottom: 1.5rem;
}

.shaLogo {
  width: 56px;
  height: 56px;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5));
}

.statusBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 5px 14px;
  background: rgba(245, 158, 11, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.35);
  border-radius: 999px;
  font-size: 0.8rem;
  color: #f59e0b;
  font-weight: 600;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.pulsingDot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #f59e0b;
  box-shadow: 0 0 8px #f59e0b;
  animation: pulseDot 1.8s infinite;
}

@keyframes pulseDot {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 12px #f59e0b; }
  100% { transform: scale(0.9); opacity: 0.7; }
}

.maintenanceTitle {
  font-size: 1.85rem;
  margin-bottom: 0.85rem;
  color: #f8fafc;
}

.maintenanceDesc {
  color: var(--text-secondary);
  font-size: 0.975rem;
  line-height: 1.6;
  margin-bottom: 0.75rem;
}

.maintenanceSubtext {
  color: var(--text-muted);
  font-size: 0.875rem;
  line-height: 1.5;
  margin-bottom: 1.25rem;
}

.etaBox {
  margin: 1.25rem auto 1.5rem auto;
  padding: 0.65rem 1.15rem;
  background: var(--bg-inset);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.875rem;
}

.etaLabel {
  color: var(--text-muted);
}

.etaValue {
  color: #f59e0b;
  font-weight: 600;
}

.cardActions {
  display: flex;
  gap: 12px;
  justify-content: center;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}

.actionBtn {
  padding: 0.65rem 1.25rem;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s ease;
}

.discordBtn {
  background: #5865F2;
  color: #ffffff;
}

.discordBtn:hover {
  background: #4752C4;
  text-decoration: none;
  box-shadow: 0 4px 14px rgba(88, 101, 242, 0.4);
}

.githubBtn {
  background: var(--bg-card-hover);
  color: var(--text-primary);
  border: 1px solid var(--border-card);
}

.githubBtn:hover {
  border-color: var(--border-focus);
  color: #ffffff;
  text-decoration: none;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
