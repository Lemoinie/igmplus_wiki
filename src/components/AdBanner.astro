---
// Collapsible Sticky Bottom Anchor Ad (Adsterra)
// Slides up on page load; users can click the arrow button to collapse it cleanly.
// Loads ONLY the 728x90 desktop banner (>= 768px) or 320x50 mobile banner (< 768px).
// When upgrading to Google AdSense later, replace this component with AdSense Auto Anchor Ads.
---

<aside id="stickyAdAnchor" class="stickyAdAnchor" aria-label="Advertisement">
  <button
    id="stickyAdToggle"
    type="button"
    class="adToggleTab"
    disabled
    aria-disabled="true"
    aria-expanded="true"
    aria-controls="stickyAdBody"
    aria-label="Advertisement loading"
    title="Ad loading…"
  >
    <svg
      class="adToggleChevron"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div id="stickyAdBody" class="stickyAdBody">
    <div class="adSlot"></div>
  </div>
</aside>

<script is:inline>
  (function () {
    var SANDBOX_FLAGS = 'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox';
    var anchor = document.getElementById('stickyAdAnchor');
    var toggle = document.getElementById('stickyAdToggle');
    var adSlot = document.querySelector('#stickyAdBody .adSlot');
    if (!anchor || !toggle || !adSlot) return;

    var adLoaded = false;

    function enableCollapse() {
      if (adLoaded) return;
      adLoaded = true;
      toggle.disabled = false;
      toggle.removeAttribute('disabled');
      toggle.removeAttribute('aria-disabled');
      toggle.setAttribute('title', 'Hide ad');
      toggle.setAttribute('aria-label', 'Collapse advertisement');
      anchor.classList.add('adReady');
    }

    toggle.addEventListener('click', function () {
      if (!adLoaded || toggle.disabled) return;
      var collapsed = anchor.classList.toggle('collapsed');
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      toggle.setAttribute(
        'aria-label',
        collapsed ? 'Show advertisement' : 'Collapse advertisement'
      );
      toggle.setAttribute('title', collapsed ? 'Show ad' : 'Hide ad');
    });

    var useDesktop = window.innerWidth >= 768;
    var config = useDesktop
      ? {
          key: '421f04da96c891e86fee7b72e418885e',
          format: 'iframe',
          height: 90,
          width: 728,
          params: {}
        }
      : {
          key: '2f2796e682f5a3ebc946abbf07634fae',
          format: 'iframe',
          height: 50,
          width: 320,
          params: {}
        };

    var sandboxFrame = document.createElement('iframe');
    sandboxFrame.className = 'adSandboxFrame';
    sandboxFrame.setAttribute('sandbox', SANDBOX_FLAGS);
    sandboxFrame.setAttribute('width', String(config.width));
    sandboxFrame.setAttribute('height', String(config.height));
    sandboxFrame.setAttribute('scrolling', 'no');
    sandboxFrame.setAttribute('frameborder', '0');
    sandboxFrame.setAttribute('title', 'Sponsored Advertisement');

    var sandboxAttrObserver = new MutationObserver(function () {
      if (sandboxFrame.getAttribute('sandbox') !== SANDBOX_FLAGS) {
        sandboxFrame.setAttribute('sandbox', SANDBOX_FLAGS);
      }
    });
    sandboxAttrObserver.observe(sandboxFrame, {
      attributes: true,
      attributeFilter: ['sandbox']
    });

    window.addEventListener('message', function (event) {
      if (event.source !== sandboxFrame.contentWindow) return;
      if (event.data && event.data.type === 'igm-ad-ready') {
        enableCollapse();
      }
    });

    var hardeningScript =
      '(function () {' +
      '  var SANDBOX = ' + JSON.stringify(SANDBOX_FLAGS) + ';' +
      '  try {' +
      '    Object.defineProperty(window, "frameElement", {' +
      '      get: function () { return null; },' +
      '      configurable: false' +
      '    });' +
      '  } catch (e) {}' +
      '  var lastInteraction = 0;' +
      '  function markInteraction() { lastInteraction = Date.now(); }' +
      '  ["mousedown", "pointerdown", "touchstart", "click"].forEach(function (evt) {' +
      '    document.addEventListener(evt, markInteraction, true);' +
      '  });' +
      '  var origOpen = window.open;' +
      '  window.open = function () {' +
      '    if (Date.now() - lastInteraction <= 1500) {' +
      '      return origOpen.apply(window, arguments);' +
      '    }' +
      '    return null;' +
      '  };' +
      '  var readySent = false;' +
      '  function notifyReady() {' +
      '    if (readySent) return;' +
      '    readySent = true;' +
      '    try {' +
      '      window.parent.postMessage({ type: "igm-ad-ready" }, "*");' +
      '    } catch (e) {}' +
      '  }' +
      '  function isVisibleBox(el) {' +
      '    return Boolean(el && el.isConnected && el.offsetWidth > 0 && el.offsetHeight > 0);' +
      '  }' +
      '  function enforceSandbox(iframe) {' +
      '    if (!iframe) return;' +
      '    if (iframe.getAttribute("sandbox") !== SANDBOX) {' +
      '      iframe.setAttribute("sandbox", SANDBOX);' +
      '    }' +
      '  }' +
      '  function bindFrame(iframe) {' +
      '    if (!iframe) return;' +
      '    enforceSandbox(iframe);' +
      '    if (iframe.dataset.adBound) return;' +
      '    iframe.dataset.adBound = "1";' +
      '    function verifyLoaded() {' +
      '      if (readySent) return;' +
      '      window.setTimeout(function () {' +
      '        if (isVisibleBox(iframe)) notifyReady();' +
      '      }, 250);' +
      '    }' +
      '    iframe.addEventListener("load", verifyLoaded, { once: true });' +
      '    window.setTimeout(function () {' +
      '      if (readySent || !isVisibleBox(iframe)) return;' +
      '      var hasSrc = Boolean(iframe.getAttribute("src"));' +
      '      var populatedSameOrigin = false;' +
      '      try {' +
      '        var doc = iframe.contentDocument;' +
      '        populatedSameOrigin = Boolean(doc && doc.readyState === "complete" && doc.body && doc.body.childElementCount > 0);' +
      '      } catch (e) {' +
      '        populatedSameOrigin = true;' +
      '      }' +
      '      if (hasSrc || populatedSameOrigin) notifyReady();' +
      '    }, 1200);' +
      '  }' +
      '  function bindCreativeImg(img) {' +
      '    if (!img || img.dataset.adBound) return;' +
      '    img.dataset.adBound = "1";' +
      '    if (img.complete && img.naturalWidth > 0 && isVisibleBox(img)) {' +
      '      notifyReady();' +
      '    } else {' +
      '      img.addEventListener("load", function () {' +
      '        if (img.naturalWidth > 0 && isVisibleBox(img)) notifyReady();' +
      '      }, { once: true });' +
      '    }' +
      '  }' +
      '  function scanDocument() {' +
      '    var frames = document.querySelectorAll("iframe");' +
      '    for (var i = 0; i < frames.length; i++) bindFrame(frames[i]);' +
      '    if (readySent) return;' +
      '    var imgs = document.querySelectorAll("img");' +
      '    for (var j = 0; j < imgs.length; j++) bindCreativeImg(imgs[j]);' +
      '  }' +
      '  var observer = new MutationObserver(scanDocument);' +
      '  observer.observe(document.documentElement, { childList: true, subtree: true });' +
      '  document.addEventListener("DOMContentLoaded", scanDocument);' +
      '  window.addEventListener("load", scanDocument);' +
      '})();';

    var sOpen = '<scr' + 'ipt>';
    var sClose = '</scr' + 'ipt>';
    sandboxFrame.srcdoc =
      '<!doctype html>' +
      '<html>' +
      '<head>' +
      '<meta charset="utf-8">' +
      '<style>html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:transparent;display:flex;align-items:center;justify-content:center;}</style>' +
      sOpen + hardeningScript + sClose +
      '</head>' +
      '<body>' +
      sOpen + 'window.atOptions=' + JSON.stringify(config) + ';' + sClose +
      '<scr' + 'ipt src="https://bauval.org/22/' + config.key + '">' + sClose +
      '</body>' +
      '</html>';

    adSlot.appendChild(sandboxFrame);
  })();
</script>

<style>
  .stickyAdAnchor {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 110;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    transform: translateY(0);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    animation: adSlideUp 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stickyAdAnchor.collapsed {
    transform: translateY(calc(100% - 24px));
  }

  .adToggleTab {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    background: var(--bg-sidebar);
    color: var(--text-muted);
    cursor: pointer;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.35);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .adToggleTab:hover {
    color: var(--text-primary);
    background: var(--bg-card);
  }

  .adToggleTab:disabled {
    opacity: 0.38;
    cursor: not-allowed;
    color: var(--text-muted);
  }

  .adToggleTab:disabled:hover {
    color: var(--text-muted);
    background: var(--bg-sidebar);
  }

  .adToggleChevron {
    transition: transform 0.25s ease;
  }

  .stickyAdAnchor.collapsed .adToggleChevron {
    transform: rotate(180deg);
  }

  .stickyAdBody {
    pointer-events: auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background: color-mix(in srgb, var(--bg-sidebar) 94%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--border-subtle);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.45);
  }

  .adSlot {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 50px;
    overflow: hidden;
  }

  .adSlot :global(.adSandboxFrame) {
    border: 0;
    display: block;
    max-width: 100%;
    overflow: hidden;
    background: transparent;
  }

  @media (min-width: 768px) {
    .adSlot {
      min-height: 90px;
    }
  }

  @keyframes adSlideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
