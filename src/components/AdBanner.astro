---
// Responsive Adsterra Banner Component
// Loads ONLY the 728x90 desktop banner or 320x50 mobile banner based on available width.
// When upgrading to Google AdSense later, replace this single component.
---

<aside class="adBannerSection" aria-label="Advertisement">
  <span class="adLabel">Advertisement</span>
  <div class="adSlot">
    <script is:inline>
      (function () {
        // Desktop layout has a fixed sidebar (~260px) + padding above 959px,
        // so require >= 1100px viewport width before serving the 728x90 banner.
        var useDesktop = window.innerWidth >= 1100;
        var config = useDesktop
          ? {
              key: '421f04da96c891e86fee7b72e418885e',
              format: 'iframe',
              height: 90,
              width: 728,
              params: {}
            }
          : {
              key: '2f2796e682f5a3ebc946abbf07634fae',
              format: 'iframe',
              height: 50,
              width: 320,
              params: {}
            };

        window.atOptions = config;
        document.write(
          '<scr' +
            'ipt src="https://bauval.org/22/' +
            config.key +
            '"></scr' +
            'ipt>'
        );
      })();
    </script>
  </div>
</aside>

<style>
  .adBannerSection {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 1rem 1rem 1.25rem;
    margin: 0 auto;
    width: 100%;
    max-width: 1400px;
    border-top: 1px solid var(--border-subtle);
  }

  .adLabel {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    opacity: 0.7;
    user-select: none;
  }

  .adSlot {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 50px;
    overflow: hidden;
  }

  @media (min-width: 1100px) {
    .adSlot {
      min-height: 90px;
    }
  }
</style>
