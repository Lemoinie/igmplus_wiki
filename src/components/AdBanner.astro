---
// Collapsible Sticky Bottom Anchor Ad (Adsterra)
// Slides up on page load; users can click the arrow button to collapse it cleanly.
// Loads ONLY the 728x90 desktop banner (>= 768px) or 320x50 mobile banner (< 768px).
// When upgrading to Google AdSense later, replace this component with AdSense Auto Anchor Ads.
---

<aside id="stickyAdAnchor" class="stickyAdAnchor" aria-label="Advertisement">
  <button
    id="stickyAdToggle"
    type="button"
    class="adToggleTab"
    disabled
    aria-disabled="true"
    aria-expanded="true"
    aria-controls="stickyAdBody"
    aria-label="Advertisement loading"
    title="Ad loading…"
  >
    <svg
      class="adToggleChevron"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div id="stickyAdBody" class="stickyAdBody">
    <div class="adSlot">
      <script is:inline>
        (function () {
          var useDesktop = window.innerWidth >= 768;
          var config = useDesktop
            ? {
                key: '421f04da96c891e86fee7b72e418885e',
                format: 'iframe',
                height: 90,
                width: 728,
                params: {}
              }
            : {
                key: '2f2796e682f5a3ebc946abbf07634fae',
                format: 'iframe',
                height: 50,
                width: 320,
                params: {}
              };

          window.atOptions = config;
          document.write(
            '<scr' +
              'ipt src="https://bauval.org/22/' +
              config.key +
              '"></scr' +
              'ipt>'
          );
        })();
      </script>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    var anchor = document.getElementById('stickyAdAnchor');
    var toggle = document.getElementById('stickyAdToggle');
    var adSlot = document.querySelector('#stickyAdBody .adSlot');
    if (!anchor || !toggle) return;

    var adLoaded = false;

    function enableCollapse() {
      if (adLoaded) return;
      adLoaded = true;
      toggle.disabled = false;
      toggle.removeAttribute('disabled');
      toggle.removeAttribute('aria-disabled');
      toggle.setAttribute('title', 'Hide ad');
      toggle.setAttribute('aria-label', 'Collapse advertisement');
      anchor.classList.add('adReady');
    }

    function isVisibleBox(el) {
      return Boolean(el && el.isConnected && el.offsetWidth > 0 && el.offsetHeight > 0);
    }

    function bindFrame(iframe) {
      if (!iframe || iframe.dataset.adBound) return;
      iframe.dataset.adBound = '1';

      function verifyLoaded() {
        if (adLoaded) return;
        window.setTimeout(function () {
          if (isVisibleBox(iframe)) {
            enableCollapse();
          }
        }, 250);
      }

      iframe.addEventListener('load', verifyLoaded, { once: true });

      // Fallback in case the iframe load event fired before this listener attached
      window.setTimeout(function () {
        if (adLoaded || !isVisibleBox(iframe)) return;
        var hasSrc = Boolean(iframe.getAttribute('src'));
        var populatedSameOrigin = false;
        try {
          var doc = iframe.contentDocument;
          populatedSameOrigin = Boolean(doc && doc.readyState === 'complete' && doc.body && doc.body.childElementCount > 0);
        } catch (e) {
          // Cross-origin iframe means external ad document loaded
          populatedSameOrigin = true;
        }
        if (hasSrc || populatedSameOrigin) {
          enableCollapse();
        }
      }, 1200);
    }

    function bindCreativeImg(img) {
      if (!img || img.dataset.adBound) return;
      img.dataset.adBound = '1';
      if (img.complete && img.naturalWidth > 0 && isVisibleBox(img)) {
        enableCollapse();
      } else {
        img.addEventListener('load', function () {
          if (img.naturalWidth > 0 && isVisibleBox(img)) {
            enableCollapse();
          }
        }, { once: true });
      }
    }

    function scanSlot() {
      if (!adSlot || adLoaded) return;
      var frames = adSlot.querySelectorAll('iframe');
      for (var i = 0; i < frames.length; i++) {
        bindFrame(frames[i]);
      }
      var imgs = adSlot.querySelectorAll('img');
      for (var j = 0; j < imgs.length; j++) {
        bindCreativeImg(imgs[j]);
      }
    }

    if (adSlot) {
      scanSlot();
      var observer = new MutationObserver(function () {
        scanSlot();
        if (adLoaded) observer.disconnect();
      });
      observer.observe(adSlot, { childList: true, subtree: true });
    }

    toggle.addEventListener('click', function () {
      if (!adLoaded || toggle.disabled) return;
      var collapsed = anchor.classList.toggle('collapsed');
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      toggle.setAttribute(
        'aria-label',
        collapsed ? 'Show advertisement' : 'Collapse advertisement'
      );
      toggle.setAttribute('title', collapsed ? 'Show ad' : 'Hide ad');
    });
  })();
</script>

<style>
  .stickyAdAnchor {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 110;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    transform: translateY(0);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    animation: adSlideUp 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stickyAdAnchor.collapsed {
    transform: translateY(calc(100% - 24px));
  }

  .adToggleTab {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    background: var(--bg-sidebar);
    color: var(--text-muted);
    cursor: pointer;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.35);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .adToggleTab:hover {
    color: var(--text-primary);
    background: var(--bg-card);
  }

  .adToggleTab:disabled {
    opacity: 0.38;
    cursor: not-allowed;
    color: var(--text-muted);
  }

  .adToggleTab:disabled:hover {
    color: var(--text-muted);
    background: var(--bg-sidebar);
  }

  .adToggleChevron {
    transition: transform 0.25s ease;
  }

  .stickyAdAnchor.collapsed .adToggleChevron {
    transform: rotate(180deg);
  }

  .stickyAdBody {
    pointer-events: auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background: color-mix(in srgb, var(--bg-sidebar) 94%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--border-subtle);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.45);
  }

  .adSlot {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 50px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .adSlot {
      min-height: 90px;
    }
  }

  @keyframes adSlideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
