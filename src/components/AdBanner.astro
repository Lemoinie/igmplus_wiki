---
// Collapsible Sticky Bottom Anchor Ad (Adsterra)
// Slides up on page load; users can click the arrow button to collapse it cleanly.
// Loads ONLY the 728x90 desktop banner (>= 768px) or 320x50 mobile banner (< 768px).
// When upgrading to Google AdSense later, replace this component with AdSense Auto Anchor Ads.
---

<aside id="stickyAdAnchor" class="stickyAdAnchor" aria-label="Advertisement">
  <button
    id="stickyAdToggle"
    type="button"
    class="adToggleTab"
    aria-expanded="true"
    aria-controls="stickyAdBody"
    aria-label="Collapse advertisement"
    title="Hide ad"
  >
    <svg
      class="adToggleChevron"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div id="stickyAdBody" class="stickyAdBody">
    <div class="adSlot">
      <script is:inline>
        (function () {
          var useDesktop = window.innerWidth >= 768;
          var config = useDesktop
            ? {
                key: '421f04da96c891e86fee7b72e418885e',
                format: 'iframe',
                height: 90,
                width: 728,
                params: {}
              }
            : {
                key: '2f2796e682f5a3ebc946abbf07634fae',
                format: 'iframe',
                height: 50,
                width: 320,
                params: {}
              };

          window.atOptions = config;
          document.write(
            '<scr' +
              'ipt src="https://bauval.org/22/' +
              config.key +
              '"></scr' +
              'ipt>'
          );
        })();
      </script>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    var anchor = document.getElementById('stickyAdAnchor');
    var toggle = document.getElementById('stickyAdToggle');
    if (!anchor || !toggle) return;

    toggle.addEventListener('click', function () {
      var collapsed = anchor.classList.toggle('collapsed');
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      toggle.setAttribute(
        'aria-label',
        collapsed ? 'Show advertisement' : 'Collapse advertisement'
      );
      toggle.setAttribute('title', collapsed ? 'Show ad' : 'Hide ad');
    });
  })();
</script>

<style>
  .stickyAdAnchor {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 110;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    transform: translateY(0);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    animation: adSlideUp 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stickyAdAnchor.collapsed {
    transform: translateY(calc(100% - 24px));
  }

  .adToggleTab {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    background: var(--bg-sidebar);
    color: var(--text-muted);
    cursor: pointer;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.35);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .adToggleTab:hover {
    color: var(--text-primary);
    background: var(--bg-card);
  }

  .adToggleChevron {
    transition: transform 0.25s ease;
  }

  .stickyAdAnchor.collapsed .adToggleChevron {
    transform: rotate(180deg);
  }

  .stickyAdBody {
    pointer-events: auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background: color-mix(in srgb, var(--bg-sidebar) 94%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--border-subtle);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.45);
  }

  .adSlot {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 50px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .adSlot {
      min-height: 90px;
    }
  }

  @keyframes adSlideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
